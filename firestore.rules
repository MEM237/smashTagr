rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow all authenticated users to perform all operations on their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow all authenticated users to read and write to any collection
    // This is for the simplified SmashTagr implementation
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}