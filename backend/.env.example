# SmashTagr Backend API Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# API Security
API_SECRET_KEY=your-super-secret-api-key-here
JWT_SECRET=your-jwt-secret-for-future-auth

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://your-flutter-app.com

# Database (if needed in future)
# DATABASE_URL=postgresql://user:password@localhost:5432/smashtag

# Monitoring & Logging
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# Cryptographic Settings
ENCRYPTION_ALGORITHM=aes-256-gcm
HASH_ALGORITHM=sha256

# API Rate Limiting
GENERATE_ENDPOINT_RATE_LIMIT=10
GENERATE_ENDPOINT_WINDOW_MS=60000

# Production Settings (uncomment for production)
# NODE_ENV=production
# ENABLE_HTTPS=true
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem